{
  "name": "dsh-maintainer-workbench",
  "version": "0.2.2",
  "description": "Repository maintenance workbench for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/RESEARCH.md",
    "third_party",
    "skills",
    "docs/VALIDATION.md",
    "docs/ACCEPTANCE.md",
    "docs/evidence",
    "docs/product",
    "docs/EVALUATION.md",
    "scripts/verify-document-patch.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "dev": "tsx watch src/server/dev.ts",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "harness": "node scripts/harness.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:navigation": "node scripts/browser-navigation-fixture.mjs",
    "test:native": "node scripts/native-fixture.mjs",
    "harness:isolated": "node scripts/harness.mjs --isolated",
    "evaluate": "node scripts/evaluate.mjs",
    "test:browser:maintenance": "node --import tsx scripts/browser-maintenance-fixture.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || ^0.2.1-alpha.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.55.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1"
  }
}
